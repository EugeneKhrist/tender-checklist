# Скопируйте этот файл в .env, если нужно что-то поменять. Для запуска по умолчанию .env не обязателен.

# Порт, на котором открывается приложение: http://localhost:3000
PORT=3000

# Входа в приложении нет, поэтому по умолчанию оно доступно только с этого компьютера (127.0.0.1).
# Чтобы открывать его с телефона по Wi-Fi: HOST=0.0.0.0 и ALLOWED_HOSTS=<адрес компьютера в сети, например 192.168.1.25>.
# Внимание: тогда любой в вашей сети сможет открыть приложение и увидеть данные.
# HOST=127.0.0.1
# ALLOWED_HOSTS=

# Папка с данными: база SQLite (tenders.db) и загруженные скриншоты (uploads/).
# DATA_DIR=./data

# Распознавание: локальная модель Ollama (без ключей и интернета).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5vl:7b
# Размер контекста модели в токенах: меньше — быстрее и легче для видеокарты, но влезает меньше скриншотов.
# OLLAMA_NUM_CTX=16384
# Сколько фрагментов (по ~6000 знаков) читать из одного длинного документа или страницы.
# OLLAMA_MAX_CHUNKS=10
